// lissajous — two perpendicular sine waves, one running ahead of the other.
// drag a and b: whole-number ratios close the curve, anything else never does.

a = slider(3, 1, 9, step=1)
b = slider(2, 1, 9, step=1)

time T = time(0..6.28, period=8000)

// the phase drifts through a full cycle, so the figure folds and opens again
d = wobble(T, 3.14159)

curve figure = curve(t -> (sin(a * t + d), sin(b * t)), 0..6.28 step 0.01) as { gradient: gradient("blue", "red") }

point head = (sin(a * T + d), sin(b * T)) as { color: red, pointSize: 14 }

text ratio = text("a:b", at=(0, 1.25))
