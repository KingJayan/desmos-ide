{
  "name": "desmos-ide",
  "version": "1.5.6",
  "description": "an IDE for Desmos with a custom DSL",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun build:view && electrobun dev",
    "dev:hmr": "bun run build:native && DESMOS_IDE_DEV=1 bun run --parallel vite \"electrobun dev\"",
    "build:view": "vite build && bun run build:native",
    "build:native": "bun run scripts/build-native.ts",
    "build:grammar": "bun run scripts/build-grammar.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "pack:vsix": "bun run scripts/pack-vsix.ts",
    "pack:cli": "bun run scripts/build-cli.ts && bun run scripts/pack-cli.ts",
    "pack:linux": "bun run scripts/pack-linux.ts",
    "formula": "bun run scripts/gen-formula.ts",
    "cask": "bun run scripts/gen-cask.ts",
    "windows": "bun run scripts/gen-windows.ts",
    "build": "bun build:view && electrobun build",
    "build:release": "bun build:view && electrobun build --env=stable",
    "check": "tsc --noEmit --pretty false | grep 'error TS' | grep -v '^node_modules/' && exit 1 || exit 0",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "demo": "bun run src/demo.ts",
    "bench": "bun run src/bench/index.ts",
    "test": "bun run scripts/test.ts",
    "test:e2e": "bun run build:view && bun run scripts/smoke.ts",
    "bump": "scripts/bump.sh",
    "bump:patch": "scripts/bump.sh patch",
    "bump:minor": "scripts/bump.sh minor",
    "bump:major": "scripts/bump.sh major",
    "bump:hotfix": "scripts/bump.sh hotfix",
    "release": "bash scripts/release.sh",
    "r": "bun run build && bun run dev",
    "dsmx": "bun run cli/dsmx.ts"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "electrobun": "^1.18.1",
    "katex": "^0.16.45",
    "lucide": "^1.8.0",
    "monaco-editor": "^0.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "linkedom": "^0.18.13",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "sass-embedded": "^1.103.1",
    "typescript": "^5.3.0",
    "vite": "^8.2.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
