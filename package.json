{
  "name": "desmos-ide",
  "version": "1.4.0",
  "description": "an IDE for Desmos with a custom DSL",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun build:view && electrobun dev",
    "dev:hmr": "bun run build:native && DESMOS_IDE_DEV=1 concurrently -k \"vite\" \"electrobun dev\"",
    "build:view": "vite build && bun run build:native",
    "build:native": "bun run scripts/build-native.ts",
    "build:grammar": "bun run scripts/build-grammar.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "pack:cli": "bun run scripts/build-cli.ts && bun run scripts/pack-cli.ts",
    "formula": "bun run scripts/gen-formula.ts",
    "build": "bun build:view && electrobun build",
    "check": "tsc --noEmit",
    "demo": "bun run src/demo.ts",
    "test": "bun test src/tests/",
    "test:e2e": "bun run build:view && bun run e2e/smoke.ts",
    "bump:patch": "bun pm version patch --no-git-tag-version",
    "bump:minor": "bun pm version minor --no-git-tag-version",
    "bump:major": "bun pm version major --no-git-tag-version",
    "bump:prepatch": "bun pm version prepatch --no-git-tag-version --preid=beta",
    "ready": "bun run bump:patch && bun run build",
    "release": "bash scripts/release.sh",
    "r": "bun run build && bun run dev",
    "dsmx": "bun run cli/dsmx.ts"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "electrobun": "^1.18.1",
    "katex": "^0.16.45",
    "lucide": "^1.8.0",
    "monaco-editor": "^0.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.4",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1",
    "sass": "^1.102.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
