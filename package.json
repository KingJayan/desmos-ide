{
  "name": "desmos-ide",
  "version": "1.2.4",
  "description": "an ide for Desmos with a custom dsl",
  "scripts": {
    "dev": "npm run build:view && electrobun dev",
    "dev:hmr": "DESMOS_IDE_DEV=1 concurrently -k \"vite\" \"electrobun dev\"",
    "build:view": "vite build",
    "build": "npm run build:view && electrobun build",
    "check": "npx tsc --noEmit 2>&1",
    "demo": "npx ts-node -P tsconfig.node.json src/demo.ts",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --require ts-node/register --test src/tests/*.test.ts",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "bump:prepatch": "npm version prepatch --no-git-tag-version --preid=beta",
    "ready": "npm run bump:patch && npm run build",
    "r": "npm run build && npm run dev"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@types/katex": "^0.16.8",
    "electrobun": "^1.18.1",
    "katex": "^0.16.45",
    "lucide": "^1.8.0",
    "monaco-editor": "^0.45.0"
  },
  "license": "MIT"
}
