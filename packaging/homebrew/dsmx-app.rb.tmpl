# generated by scripts/gen-cask.ts
cask "dsmx-app" do
{{ARCH}}

  url "https://github.com/KingJayan/desmos-ide/releases/download/v#{version}/{{APP}}-#{version}-{{ARCHREF}}.zip"
  name "dsmx"
  desc "IDE for Desmos with a custom DSL"
  homepage "https://github.com/KingJayan/desmos-ide"

{{ARCHDEP}}  depends_on macos: :sonoma

  app "{{APP}}.app"

  # the app carries an ad-hoc signature, not a Developer ID one, so Gatekeeper
  # would refuse it on first launch. drop the flag homebrew set on the download
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/{{APP}}.app"]
  end

  zap trash: [
    "~/Library/Application Support/{{APP}}",
    "~/Library/Caches/dev.desmoside.app",
    "~/Library/Preferences/dev.desmoside.app.plist",
    "~/Library/Saved Application State/dev.desmoside.app.savedState",
  ]
end
