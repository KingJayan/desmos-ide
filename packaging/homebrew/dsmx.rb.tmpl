# generated by scripts/gen-formula.ts
class Dsmx < Formula
  desc "Run .dsmx files in a live Desmos graph, straight from the terminal"
  homepage "https://github.com/KingJayan/desmos-ide"
  url "https://github.com/KingJayan/desmos-ide/releases/download/v{{VERSION}}/dsmx-{{VERSION}}.tar.gz"
  sha256 "{{SHA256}}"
  license "Apache-2.0"

  depends_on "node"

  def install
    libexec.install "dsmx.mjs", "dsmx"
    chmod 0755, libexec/"dsmx"
    bin.install_symlink libexec/"dsmx"
    pkgshare.install "example"
    prefix.install "LICENSE"
  end

  def caveats
    <<~EOS
      dsmx draws with the Desmos API, which it loads over the network the first time.

      Example files are in:
        #{opt_pkgshare}/example

      Try one with:
        dsmx run #{opt_pkgshare}/example/orbit.dsmx
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/dsmx --version")

    (testpath/"t.dsmx").write "point p (1, 2)\n"
    system bin/"dsmx", "build", "t.dsmx", "-o", "t.json"
    assert_match "\\\\left(1,2\\\\right)", (testpath/"t.json").read

    assert_match "is not a .dsmx file", shell_output("#{bin}/dsmx build t.json 2>&1", 1)
  end
end
