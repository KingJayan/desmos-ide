{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "renderer/**/*", "bun/**/*", "cli/**/*", "electrobun.config.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "build", "out"]
}
